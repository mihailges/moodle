    @template core_admin/oauth2/server/client_created_alert
    @summary Renders the content of the alert displayed right after a new OAuth2 client is created.

    Context variables required for this template:
    * name - The name of the newly created client.
    * isconfidential - Whether the newly created client is confidential or not.
    * editclientlink - The URL to edit the newly created client.

    Example context (json):
    {
        "name": "My New Client",
        "isconfidential": true,
        "editclientlink": "https://moodle.org/admin/oauth2server/clients/1/edit",
    }
}}
<div class="d-flex align-items-start">
    <div class="d-flex align-items-start">
        <div class="me-2">
            <i class="fa fa-check-circle" aria-hidden="true"></i>
        </div>
        <div class="flex-grow-1">
            <div>
                {{#str}} oauth2server_clientcreated, admin, {{name}} {{/str}}
            </div>
            {{#isconfidential}}
                <div class="d-flex align-items-start mt-3">
                    <div class="me-2 text-warning">
                        <i class="fa fa-exclamation-triangle" aria-hidden="true"></i>
                    </div>
                    <div>
                        <div>
                            {{#str}} oauth2server_clientcreatedsecretwarning, admin, {{{editclientlink}}} {{/str}}
                        </div>
                    </div>
                </div>
            {{/isconfidential}}
        </div>
    </div>
</div>
