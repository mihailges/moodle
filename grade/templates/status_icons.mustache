{{!
    @template core_grades/status_icons

    Template for the grade status icons.

    Example context (json):
    {
        "classes": "text-muted gradestatus",
        "hidden": "Hidden",
        "locked": "Locked",
        "overridden": "Overridden",
        "excluded": "Excluded",
        "feedback": "Feedback provided"
    }
}}
<div class="{{classes}}">
    {{#hidden}}{{#pix}}i/show, moodle, {{hidden}}{{/pix}}{{/hidden}}
    {{#locked}}{{#pix}}i/lock, moodle, {{locked}}{{/pix}}{{/locked}}
    {{#overridden}}{{#pix}}i/overriden_grade, moodle, {{overridden}}{{/pix}}{{/overridden}}
    {{#excluded}}{{#pix}}i/excluded, moodle, {{excluded}}{{/pix}}{{/excluded}}
    {{#feedback}}{{#pix}}i/asterisk, moodle, {{feedback}}{{/pix}}{{/feedback}}
</div>
