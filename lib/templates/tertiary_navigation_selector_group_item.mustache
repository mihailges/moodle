{{!
    @template core/tertiary_navigation_selector_group_item

    Tertiary navigation selector group item.

    Context variables required for this template:
    * name - The name of the tertiary navigation selector group.
    * actionitems - Array of tertiary navigation action items.

    Example context (json):
    {
        "name": "Group",
        "actionitems": [
            {
                "name": "Action item 2",
                "action": "/example2.php",
                "isactive": false,
                "attributes": [
                    {
                        "name": "target",
                        "value": "_blank"
                    }
                ]
            }
        ]
    }
}}
<li role="none">
    <span class="dropdown-header" aria-hidden="true">{{name}}</span>
    <ul class="dropdown-group" role="group" aria-label="{{name}}">
        {{#actionitems}}
            {{> core/tertiary_navigation_selector_action_item }}
        {{/actionitems}}
    </ul>
</li>
