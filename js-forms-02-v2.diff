+import {Alert, type AlertProps} from '@moodlehq/design-system';
+import {useFieldConditions, type FieldBehaviour} from '../useDefinedField';
+
+// Static message that takes no value; it can still be shown or hidden by a condition.
+export function NoticeField({message, type = 'info', hideIf, name = 'notice'}: Pick<AlertProps, 'message' | 'type'> &
+    Pick<FieldBehaviour, 'hideIf'> & {name?: string}) {
+    const {hidden} = useFieldConditions(name, {hideIf});
+    return hidden ? null : <Alert type={type} message={message} />;
+}
