{{!
    @template mod_data/presets_action_bar
    Actions menu at the top of the field/presets pages in the database activity.
    Classes required for JS:
    * none
    Data attributes required for JS:
    * data-region
    Context variables required for this template:
    * see mod/data/classes/output/fields_action_bar.php
}}
<h4>{{#str}}presets, mod_data{{/str}}</h4>
<form method="post" action="{{formactionul}}" class="mt-4">
    <input type="hidden" name="d" value="{{d}}">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <input type="hidden" name="action" value="select">
    {{{presetstable}}}
    <input type="submit" name="selectpreset" value="{{#str}}save, core{{/str}}" class="btn btn-primary mt-2">
</form>