@@ -0,0 +1,38 @@
+import {Component, type ReactNode} from 'react';
+import {useFormContext} from 'react-hook-form';
+import {getFormExtensions} from './formExtension';
+
+const DEFAULT_ORDER = 100;
+
+// Contains a failing plugin extension so it cannot take the whole form down.
+class ExtensionBoundary extends Component<{plugin: string; children: ReactNode}, {failed: boolean}> {
+    state = {failed: false};
+
+    static getDerivedStateFromError() {
+        return {failed: true};
+    }
+
+    componentDidCatch(error: unknown) {
+        window.console.error(`[forms] extension from ${this.props.plugin} failed to render`, error);
+    }
+
+    render() {
+        return this.state.failed ? null : this.props.children;
+    }
+}
+
+// Renders the extensions plugins registered for this slot, lowest order first.
+export function FormSlot({name}: {name: string}) {
+    const {control} = useFormContext();
+    // Array.sort is stable, so equal orders keep their registration order.
+    const extensions = [...getFormExtensions(name)].sort((a, b) => (a.order ?? DEFAULT_ORDER) - (b.order ?? DEFAULT_ORDER));
+    return (
+        <>
+            {extensions.map(({component: Extension, plugin, id}) => (
+                <ExtensionBoundary key={`${plugin}:${id ?? ''}`} plugin={plugin}>
+                    <Extension control={control} />
+                </ExtensionBoundary>
+            ))}
+        </>
+    );
+}
diff --git a/public/lib/js/esm/src/forms/core/slots/formExtension.ts b/public/lib/js/esm/src/forms/core/slots/formExtension.ts
new file mode 100644
index 00000000000..0a7e568a12a
--- /dev/null
+++ b/public/lib/js/esm/src/forms/core/slots/formExtension.ts
@@ -0,0 +1,29 @@
+import type {ComponentType} from 'react';
+
+export type FormExtension = {
+    slot: string;
+    plugin: string;
+    // Distinguishes several extensions of one plugin in the same slot; also their React key.
+    id?: string;
+    order?: number;
+    // Rendered inside the form; use useFormField or the core fields so values, rules and errors are shared.
+    component: ComponentType<{control: any}>;
+};
+
+const extensions: FormExtension[] = [];
+
+const sameExtension = (a: FormExtension, b: FormExtension) =>
+    a.slot === b.slot && a.plugin === b.plugin && (a.id ?? '') === (b.id ?? '');
+
+// Registering the same slot, plugin and id again replaces the earlier entry.
+export function registerFormExtension(extension: FormExtension): void {
+    const existing = extensions.findIndex((e) => sameExtension(e, extension));
+    if (existing >= 0) {
+        extensions.splice(existing, 1);
+    }
+    extensions.push(extension);
+}
+
+export function getFormExtensions(slot: string): FormExtension[] {
+    return extensions.filter((e) => e.slot === slot);
+}
