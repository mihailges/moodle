{{!
    @template mod_quiz/quiz_preview_edit_action
    Actions panel at the bottom of the assignment grading UI.
    Classes required for JS:
    * none
    Data attributes required for JS:
    * data-region
    Context variables required for this template:
    * see mod/quiz/classes/output/previeweditaction.php
}}
<div class="container-fluid">
    <div class="row">
        {{#back}}
            <div class="backclass">
                <a class="btn btn-primary" href="{{{back}}}">{{#str}}backtoquizview, quiz {{/str}}</a>
            </div>
        {{/back}}
        {{#previewlink}}
            <div class="{{prevclass}}">
                <a class="btn btn-primary" href="{{{previewlink}}}">{{#str}}preview, quiz {{/str}}</a>
            </div>
        {{/previewlink}}
        {{#editlink}}
            <div class="{{editclass}}">
                <a class="btn btn-primary" href="{{{editlink}}}">{{#str}}editquiz, quiz{{/str}}</a>
            </div>
        {{/editlink}}
    </div>
</div>
