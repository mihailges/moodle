{{!
    @template mod_quiz/quiz_preview_action
    Actions panel at the bottom of the assignment grading UI.
    Classes required for JS:
    * none
    Data attributes required for JS:
    * none
    Context variables required for this template:
    * see mod/quiz/classes/output/previeweditaction.php
    Example context (json):
    {
        "back": "http://localhost/mod/quiz/view.php?id=2",
        "editlink": "http://localhost/mod/quiz/edit.php?cmid=3"
    }
}}
<div class="container-fluid mb-3">
    <div class="row">
        {{#back}}
            <div class="col-xs-6">
                <a href="{{back}}"><button class="btn btn-secondary">{{#str}}back, core {{/str}}</button></a>
            </div>
        {{/back}}
        {{#editlink}}
            {{#back}}
            <div class="col-sm-6">
            {{/back}}
            {{^back}}
            <div class="mr-2">
            {{/back}}
            <a href="{{editlink}}"><button class="btn btn-primary">{{#str}}editquiz, quiz{{/str}}</button></a>
        </div>
        {{/editlink}}
    </div>
</div>
