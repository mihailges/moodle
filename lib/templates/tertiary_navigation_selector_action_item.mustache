{{!
    @template core/tertiary_navigation_selector_action_item

    Tertiary navigation selector group item.

    Context variables required for this template:
    * name - The name of the tertiary navigation action item.
    * action - The action associated with the item.
    * isactive - Whether the tertiary navigation action item is active.
    * attributes - Array of additional HTML attributes.

    Example context (json):
    {
        "name": "Action item 2",
        "action": "/example2.php",
        "isactive": false,
        "attributes": [
            {
                "name": "target",
                "value": "_blank"
            }
        ]
    }
}}
<li role="none">
    <a role="menuitem" class="dropdown-item {{#isactive}}active{{/isactive}}" href="{{action}}" {{#isactive}}aria-current="true"{{/isactive}} {{#attributes}}{{name}}="{{value}}"{{/attributes}} tabindex="-1">
        {{name}}
    </a>
</li>
