+    redirectUriInvalid: string;
+    addRedirectUri: string;
+    remove: string;
+    pkce: string;
+    pkceHelp: string;
+    scopes: string;
+    scopesRequired: string;
+    loading: string;
+    submit: string;
+    saving: string;
+    cancel: string;
+    genericError: string;
+};
+
+export type ScopeOption = Required<Option>;
+
+export const NAME_MAX_LENGTH = 255;
+
+export function DetailsFields({strings}: {strings: ClientStrings}) {
+    return (
+        <>
+            <TextField
+                name="name"
+                label={strings.name}
+                rules={[required(strings.nameRequired), maxLength(NAME_MAX_LENGTH, strings.nameTooLong)]}
+            />
+            <TextareaField name="description" label={strings.description} />
+        </>
+    );
+}
+
+export function RedirectUriField({strings, hideIf}: {strings: ClientStrings; hideIf?: Condition}) {
+    return (
+        <RepeaterField
+            name="redirecturis"
+            label={strings.redirectUris}
+            addLabel={strings.addRedirectUri}
+            removeLabel={strings.remove}
+            hideIf={hideIf}
+        >
+            {(index) => (
+                <TextField
+                    name={`redirecturis.${index}`}
+                    label={`${strings.redirectUris} ${index + 1}`}
+                    hideLabel
+                    rules={[
+                        ...(index === 0 ? [required(strings.redirectUriRequired)] : []),
+                        url(strings.redirectUriInvalid),
+                    ]}
+                />
+            )}
+        </RepeaterField>
+    );
+}
+
+export function PkceField({strings, hideIf, help}: {strings: ClientStrings; hideIf?: Condition; help?: string}) {
+    return <CheckboxField name="ispkcerequired" label={strings.pkce} supportingText={help ?? strings.pkceHelp} hideIf={hideIf} />;
+}
+
+export function ScopesField({strings, scopes}: {strings: ClientStrings; scopes: ScopeOption[]}) {
+    return (
+        <CheckboxGroupField
+            name="scopes"
+            label={strings.scopes}
+            options={scopes}
+            loadingLabel={strings.loading}
+            rules={[(v) => (Array.isArray(v) && v.length > 0) || strings.scopesRequired]}
+        />
+    );
+}
diff --git a/public/admin/js/esm/src/oauth2/createClientForm.tsx b/public/admin/js/esm/src/oauth2/createClientForm.tsx
new file mode 100644
index 00000000000..449ec0d97d0
--- /dev/null
+++ b/public/admin/js/esm/src/oauth2/createClientForm.tsx
@@ -0,0 +1,100 @@
+import {DefinedForm} from '@moodle/lms/core/forms';
+import {
+    RadioGroupField,
+    CheckboxField,
+    GroupField,
+    NoticeField,
+    TextField,
+    TextareaField
+} from '@moodle/lms/core/forms/fields';
+import {eq, checked, not, anyOf, allOf} from '@moodle/lms/core/forms/conditions';
+import {createClient, type ClientPayload, type CreatedClient} from '@moodle/lms/core_admin/oauth2/clientApi';
+import {
+    DetailsFields, RedirectUriField, PkceField, ScopesField, type ClientStrings, type ScopeOption, NAME_MAX_LENGTH,
+} from '@moodle/lms/core_admin/oauth2/clientFields';
+import {required} from "@moodle/lms/core/forms/rules/required";
+import {maxLength} from "@moodle/lms/core/forms/rules/maxLength";
+
+type CreateStrings = ClientStrings & {
+    type: string;
+    typeConfidential: string;
+    typeConfidentialHelp: string;
+    typePublic: string;
+    typePublicHelp: string;
+    flows: string;
+    flowRequired: string;
+    flowAuthCode: string;
+    flowAuthCodeHelp: string;
+    flowClientCredentials: string;
+    flowClientCredentialsHelp: string;
+    clientCredentialsWarning: string;
+    creationWarning: string;
+};
+
+type Props = {
+    scopes: ScopeOption[];
+    listUrl: string;
+    strings: CreateStrings;
+};
+
+const isPublic = eq('clienttype', 'public');
+const authCodeUnchecked = not(checked('flows.auth_code'));
+
+export default function CreateClientForm({scopes, listUrl, strings}: Props) {
+    const typeOptions = [
+        {value: 'confidential', label: strings.typeConfidential, description: strings.typeConfidentialHelp},
+        {value: 'public', label: strings.typePublic, description: strings.typePublicHelp},
+    ];
+
+    return (
+        <DefinedForm<ClientPayload, ClientPayload, number, CreatedClient>
+            defaultValues={{
+                name: '',
+                description: '',
+                clienttype: 'confidential',
+                flows: {auth_code: true, client_credentials: false},
+                redirecturis: [''],
+                ispkcerequired: true,
+                scopes: [],
+            }}
+            create={createClient}
+            onSaved={(saved) => {
+                window.location.href = saved.redirecturl;
+            }}
+            submitLabel={strings.submit}
+            savingLabel={strings.saving}
+            genericError={strings.genericError}
+            cancel={{href: listUrl, label: strings.cancel}}
+        >
+            <TextField
+                name="name"
+                label={strings.name}
+                rules={[required(strings.nameRequired), maxLength(NAME_MAX_LENGTH, strings.nameTooLong)]}
+            />
+            <TextareaField name="description" label={strings.description} />
+            <RadioGroupField name="clienttype" label={strings.type} options={typeOptions} />
+            <GroupField
+                name="flows"
+                label={strings.flows}
+                hideIf={isPublic}
+                rules={[(v) => Boolean(v?.auth_code || v?.client_credentials) || strings.flowRequired]}
+            >
+                <CheckboxField name="flows.auth_code" label={strings.flowAuthCode} supportingText={strings.flowAuthCodeHelp} />
+                <CheckboxField
+                    name="flows.client_credentials"
+                    label={strings.flowClientCredentials}
+                    supportingText={strings.flowClientCredentialsHelp}
+                />
+            </GroupField>
+            <NoticeField
+                type="warning"
+                message={strings.clientCredentialsWarning}
+                hideIf={anyOf(isPublic, not(checked('flows.client_credentials')))}
+            />
+            <RedirectUriField strings={strings} hideIf={allOf(not(isPublic), authCodeUnchecked)} />
+            <PkceField strings={strings} hideIf={anyOf(isPublic, authCodeUnchecked)} />
+            <NoticeField type="warning" message={strings.creationWarning} />
+            <ScopesField strings={strings} scopes={scopes} />
+        </DefinedForm>
+    );
+}
diff --git a/public/admin/js/esm/src/oauth2/editClientForm.tsx b/public/admin/js/esm/src/oauth2/editClientForm.tsx
new file mode 100644
index 00000000000..c402b1b160b
--- /dev/null
+++ b/public/admin/js/esm/src/oauth2/editClientForm.tsx
@@ -0,0 +1,40 @@
+import {DefinedForm} from '@moodle/lms/core/forms';
+import {patchClient, type ClientPayload, type UpdatedClient} from '@moodle/lms/core_admin/oauth2/clientApi';
+import {
+    DetailsFields, RedirectUriField, PkceField, ScopesField, type ClientStrings, type ScopeOption,
+} from '@moodle/lms/core_admin/oauth2/clientFields';
+
+type EditValues = Pick<ClientPayload, 'name' | 'description' | 'ispkcerequired' | 'scopes' | 'redirecturis'>;
+
+type Props = {
+    clientId: number;
+    values: EditValues;
+    // Which optional fields apply to this client.
+    hasAuthCode: boolean;
+    isConfidential: boolean;
+    scopes: ScopeOption[];
+    listUrl: string;
+    strings: ClientStrings;
+};
+
+export default function EditClientForm({clientId, values, hasAuthCode, isConfidential, scopes, listUrl, strings}: Props) {
+    return (
+        <DefinedForm<EditValues, EditValues, number, UpdatedClient>
+            defaultValues={{...values, redirecturis: values.redirecturis.length ? values.redirecturis : ['']}}
+            id={clientId}
+            update={patchClient}
+            onSaved={() => {
+                window.location.href = listUrl;
+            }}
+            submitLabel={strings.submit}
+            savingLabel={strings.saving}
+            genericError={strings.genericError}
+            cancel={{href: listUrl, label: strings.cancel}}
+        >
+            <DetailsFields strings={strings} />
+            {hasAuthCode && <RedirectUriField strings={strings} />}
+            {hasAuthCode && isConfidential && <PkceField strings={strings} />}
+            <ScopesField strings={strings} scopes={scopes} />
+        </DefinedForm>
+    );
+}
