{{!
    @template core/tertiary_navigation_selector

    Tertiary navigation selector.

    Context variables required for this template:
    * title - The title for the tertiary navigation selector.
    * activeitemtext - The text (name) of the active item in the tertiary navigation selector.
    * items - Array of tertiary navigation selector items.

    Example context (json):
    {
        "title": "Tertiary navigation",
        "activeitemtext": "Action item 1",
        "items": [
            {
                "name": "Action item 1",
                "action": "/example1.php",
                "active": true,
                "attributes": [
                    {
                        "name": "target",
                        "value": "_blank"
                    }
                ],
                "isgroup": false
            },
            {
                "name": "Group",
                "actionitems": [
                    {
                        "name": "Action item 2",
                        "action": "/example2.php",
                        "active": false,
                        "attributes": [
                            {
                                "name": "target",
                                "value": "_blank"
                            }
                        ]
                    }
                ],
                "isgroup": true
            }
        ]
    }
}}

<nav class="tertiary-navigation-selector">
    <a href="#" aria-label="{{title}}" class="dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" role="button">
        {{activeitemtext}}
    </a>
    <ul class="dropdown-menu dropdown-menu-left" role="menu">
        {{#items}}
            {{#isgroup}}
                {{> core/tertiary_navigation_selector_group_item }}
            {{/isgroup}}
            {{^isgroup}}
                {{> core/tertiary_navigation_selector_action_item }}
            {{/isgroup}}
        {{/items}}
    </ul>
</nav>
