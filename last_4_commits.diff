@@ -0,0 +1,26 @@
+import {useWatch, useFormContext} from 'react-hook-form';
+import {useFormField, type FieldProps} from '../../core/formField';
+
+type CountedTextareaFieldProps = Omit<FieldProps, 'hideLabel' | 'name'> & {
+    name: string;
+    maxLength: number;
+};
+
+// A custom field: a textarea that counts the characters left. The limit itself is enforced by the field's rules.
+export function CountedTextareaField({name, label, maxLength, rules, hideIf, disableIf, advanced}: CountedTextareaFieldProps) {
+    const f = useFormField(name, {rules, hideIf, disableIf, advanced});
+    const {control} = useFormContext();
+    const value = useWatch({control, name}) ?? '';
+    if (f.hidden) {
+        return null;
+    }
+    const left = maxLength - String(value).length;
+    return (
+        <div>
+            <label className="form-label" htmlFor={`field_${name}`}>{label}{f.requiredIndicator}</label>
+            <textarea id={`field_${name}`} className="form-control" rows={3} {...f.registration} {...f.inputProps} />
+            <div className={`small mt-1 ${left < 0 ? 'text-danger' : 'text-muted'}`}>{left} characters left</div>
+            {f.invalid && <div {...f.errorProps} className="text-danger small mt-1">{f.message}</div>}
+        </div>
+    );
+}
diff --git a/public/lib/js/esm/src/forms/test/fields/RatingField.tsx b/public/lib/js/esm/src/forms/test/fields/RatingField.tsx
new file mode 100644
index 00000000000..0fb58c3ea7e
--- /dev/null
+++ b/public/lib/js/esm/src/forms/test/fields/RatingField.tsx
@@ -0,0 +1,28 @@
+import {useFormField, type FieldProps} from '../../core/formField';
+
+type RatingFieldProps = Omit<FieldProps, 'hideLabel'> & {
+    name: string;
+    max?: number;
+};
+
+// A custom field: a 1..max rating made of native radios, so the form registers them like any other input.
+export function RatingField({name, label, max = 5, rules, hideIf, disableIf, advanced}: RatingFieldProps) {
+    const f = useFormField(name, {rules, hideIf, disableIf, advanced});
+    if (f.hidden) {
+        return null;
+    }
+    return (
+        <fieldset disabled={f.disabled}>
+            <legend className="fs-6 mb-2">{label}{f.requiredIndicator}</legend>
+            <div className="btn-group" role="group" aria-label={label}>
+                {Array.from({length: max}, (_, i) => String(i + 1)).map((value) => (
+                    <label key={value} className="btn btn-outline-primary mb-0">
+                        <input type="radio" className="me-1" value={value} {...f.registration} {...f.inputProps} />
+                        {value}
+                    </label>
+                ))}
+            </div>
+            {f.invalid && <div {...f.errorProps} className="text-danger small mt-1">{f.message}</div>}
+        </fieldset>
+    );
+}
