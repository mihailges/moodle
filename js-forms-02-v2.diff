@@ -0,0 +1,55 @@
+import {useController, useFormContext, get} from 'react-hook-form';
+import {Checkbox} from '@moodlehq/design-system';
+import {useFieldConditions, type FieldBehaviour} from '../useDefinedField';
+import {all} from '../rules/all';
+import type {FieldProps, Option} from './types';
+
+type Props = FieldProps & {
+    // Pass null while options are still loading.
+    options: Option[] | null;
+    loadingLabel?: string;
+};
+
+// The value is always an array of the selected option values, even for a single option.
+export function CheckboxGroupField({name, label, options, rules, hideIf, disableIf, id, loadingLabel = 'Loading…'}: Props) {
+    const {hidden, disabled} = useFieldConditions(name, {hideIf, disableIf} as FieldBehaviour);
+    const {control, formState: {errors}} = useFormContext();
+    const {field} = useController({
+        name,
+        control,
+        disabled,
+        shouldUnregister: true,
+        rules: {validate: rules?.length ? all(...rules) : undefined},
+    });
+    const prefix = id ?? `field_${name.replace(/\W+/g, '_')}`;
+    if (hidden) {
+        return null;
+    }
+    const error = get(errors, name);
+    const selected: string[] = Array.isArray(field.value) ? field.value : [];
+    const toggle = (value: string, checked: boolean) => {
+        field.onChange(checked ? [...selected, value] : selected.filter((v) => v !== value));
+    };
+    return (
+        <fieldset aria-describedby={error ? `${prefix}_error` : undefined}>
+            <legend className="fs-6 mb-2">{label}</legend>
+            {options === null ? (
+                <p className="text-muted">{loadingLabel}</p>
+            ) : options.map((option) => (
+                <div key={option.value} className="mb-2">
+                    <Checkbox
+                        key={option.value}
+                        id={`${prefix}_${option.value.replace(/\W+/g, '_')}`}
+                        label={option.label}
+                        supportingText={option.description}
+                        checked={selected.includes(option.value)}
+                        disabled={disabled}
+                        onBlur={field.onBlur}
+                        onChange={(e) => toggle(option.value, e.target.checked)}
+                    />
+                </div>
+            ))}
+            {error && <div id={`${prefix}_error`} className="text-danger small mt-1">{error.message as string}</div>}
+        </fieldset>
+    );
+}
