{{!
    @template core_grades/report/singleview/page_toggler

    The small selector at the top right of the page to switch between zero states.

    Example context (json):
    {
        userpage: "http://foo.bar/gradereport/?userid=25",
        userpageactive: "false",
        gradepagepage: "http://foo.bar/gradereport/?userid=25",
        gradepagepageactive: "true"
    }
}}
<div class="w-100 page-toggler d-flex justify-content-end">
    <p class="my-auto mr-3 text-uppercase">{{#str}}viewby, gradereport_singleview{{/str}}</p>
    <div class="btn-group" role="group" aria-label="TODO">
        <a href="{{userpage}}"
           type="button"
           class="btn btn-outline-primary {{#userpageactive}}active{{/userpageactive}}"
           {{#userpageactive}}aria-pressed="true"{{/userpageactive}}
           {{^userpageactive}}aria-pressed="false"{{/userpageactive}}
        >
            {{#str}}users, gradereport_singleview{{/str}}
        </a>
        <a href="{{gradepagepage}}"
           type="button"
           class="btn btn-outline-primary {{#gradepagepageactive}}active{{/gradepagepageactive}}"
           {{#gradepagepageactive}}aria-pressed="true"{{/gradepagepageactive}}
           {{^gradepagepageactive}}aria-pressed="false"{{/gradepagepageactive}}
        >
            {{#str}}gradeitems, gradereport_singleview{{/str}}
        </a>
    </div>
</div>
