    @template core_admin/oauth2/server/edit_client_action_bar
    @summary Renders the custom header on the OAuth2 client edit page.

    Context variables required for this template:
    * name - The name of the client.
    * clientidentifier - The public client identifier.
    * isactive - Whether the client is active.
    * isconfidential - Whether the client is confidential.
    * isauthcodesupported - Whether the client supports the authorization code flow.
    * isclientcredentialssupported - Whether the client supports the client credentials flow.
    * backurl - The URL to return to the clients list.
    * tertiarynavselector - An object containing the tertiary navigation selector data.
    * id - The ID of the client.
    * cancreatesecret - Whether the client can create a new secret.

    Example context (json):
    {
        "name": "Community mobile app",
        "clientidentifier": "4c7a2e9f1d6b0835",
        "isactive": true,
        "isconfidential": true,
        "isauthcodesupported": true,
        "isclientcredentialssupported": true,
        "backurl": "/admin/oauth2/clients.php",
        "tertiarynavselector": {
            "name": "Tertiary navigation selector",
            "value": "opt",
            "baseid": "select-menu1",
            "selectedoption": "Details",
            "options": [
                {
                    "selected": false,
                    "name": "Add entry template",
                    "id": "select-menu-group1"
                },
                {
                    "selected": true,
                    "name": "Single view template",
                    "value": "opt2",
                    "id": "select-menu-option2"
                }
            ]
        },
        "id": 1,
        "cancreatesecret": true
    }
}}
<div class="oauth2-client-header mb-4">
    {{>core_admin/oauth2/server/client_heading}}
    <div class="container-fluid tertiary-navigation full-width-bottom-border mt-2">
        <div class="d-flex">
            {{#tertiarynavselector}}
                <div class="navitem">
                    {{>core/tertiary_navigation_selector}}
                </div>
            {{/tertiarynavselector}}
            <div class="navitem ms-sm-auto align-self-center">
                {{#cancreatesecret}}
                    <button class="btn btn-primary" data-clientid="{{id}}" data-clientidentifier="{{clientidentifier}}" data-action="generate-secret">
                        <i class="fa fa-plus me-1" aria-hidden="true"></i>
                        {{#str}} oauth2server_clientsecretgenerate, admin {{/str}}
                    </button>
                {{/cancreatesecret}}
            </div>
        </div>
    </div>
</div>