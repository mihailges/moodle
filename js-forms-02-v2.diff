@@ -0,0 +1,49 @@
+import Fetch from '@moodle/lms/core/fetch';
+import {FormValidationError} from '@moodle/lms/core/forms';
+
+export type ClientPayload = {
+    name: string;
+    description: string;
+    clienttype: 'confidential' | 'public';
+    flows: {auth_code: boolean; client_credentials: boolean};
+    redirecturis: string[];
+    ispkcerequired: boolean;
+    scopes: string[];
+};
+
+export type CreatedClient = {id: number; isconfidential: boolean; redirecturl: string};
+
+export type UpdatedClient = Pick<ClientPayload, 'name' | 'description' | 'ispkcerequired' | 'scopes' | 'redirecturis'> & {
+    id: number;
+};
+
+// Turns a 422 response ({message, errors: {path: [messages]}}) into a FormValidationError.
+async function toError(e: unknown): Promise<unknown> {
+    if (e instanceof Response && e.status === 422) {
+        const body = await e.json();
+        return new FormValidationError(body.errors ?? {}, body.errors && Object.keys(body.errors).length ? [] : [body.message]);
+    }
+    return e instanceof Response ? new Error(e.statusText) : e;
+}
+
+export async function createClient(payload: ClientPayload): Promise<CreatedClient> {
+    try {
+        const response = await Fetch.performPost('core_admin', 'oauth2/server/clients', {body: payload, rejectWithResponse: true});
+        return await response.json();
+    } catch (e) {
+        throw await toError(e);
+    }
+}
+
+export async function patchClient(id: number, changes: Partial<ClientPayload>): Promise<UpdatedClient> {
+    try {
+        const response = await Fetch.performPatch(
+            'core_admin',
+            `oauth2/server/clients/${id}`,
+            {body: changes, rejectWithResponse: true},
+        );
+        return await response.json();
+    } catch (e) {
+        throw await toError(e);
+    }
+}
