@@ -0,0 +1,194 @@
+import {Suspense, use} from 'react';
+import {Alert} from '@moodlehq/design-system';
+import {getString} from '@moodle/lms/core/stringUtils';
+import {MoodleForm, sendFormEndpointRequest} from '@moodle/lms/core/forms';
+import {
+    GroupField,
+    RadioField,
+    CheckboxField,
+    RepeaterField,
+    StaticField,
+    TextField,
+    TextareaField,
+} from '@moodle/lms/core/forms/fields';
+import {required, maxLength, url, minItems} from '@moodle/lms/core/forms/rules';
+
+const NAME_MAX_LENGTH = 255;
+const CLIENTS_URL = '/admin/oauth2/server/clients';
+
+type Props = {
+    // The caller decides: create a client, or update the existing one (then clientId is required).
+    mode: 'create' | 'update';
+    clientId?: number;
+    // Update only: which optional fields apply to this client.
+    hasAuthCode?: boolean;
+    isConfidential?: boolean;
+    // Scope names and descriptions come from the scope classes, so they arrive as plain text.
+    scopes: {value: string; label: string; description: string}[];
+    listUrl: string;
+};
+
+type ClientPayload = {
+    name: string;
+    description: string;
+    clienttype: 'confidential' | 'public';
+    flows: string[];
+    redirecturis: string[];
+    ispkcerequired: boolean;
+    scopes: string[];
+};
+
+// A create returns the new client, an update returns the edited values.
+type Saved = Partial<ClientPayload> & {redirecturl?: string};
+
+const isPublic = (v: ClientPayload) => v.clienttype === 'public';
+
+function ClientForm({mode, clientId, hasAuthCode = false, isConfidential = false, scopes, listUrl}: Props) {
+    const isCreate = mode === 'create';
+    // Every getString starts before any `use`, so the strings load in one batch.
+    const flowRequired = use(getString('oauth2server_clientmustselectprimaryflow', 'admin'));
+    const scopesRequired = use(getString('oauth2serverclientnoscopes', 'error'));
+    const redirectUris = use(getString('oauth2server_clientcallbackuris', 'admin'));
+    const redirectUriRequired = use(getString('oauth2server_clientcallbackurirequired', 'admin'));
+    const redirectUriInvalid = use(getString('oauth2server_clientcallbackurisinvalid', 'admin'));
+    const createLabel = use(getString('oauth2server_clientcreate', 'admin'));
+    const pkceHelp = use(getString(isCreate ? 'oauth2server_clientpkcehelp' : 'oauth2server_clientpkcehelpconfidential', 'admin'));
+
+    const goToList = () => {
+        window.location.href = listUrl;
+    };
+    const modeProps = isCreate
+        ? {
+            mode: 'create' as const,
+            create: {
+                action: (payload: ClientPayload) => sendFormEndpointRequest(CLIENTS_URL, 'POST').save(payload) as Promise<Saved>,
+                label: createLabel,
+                onSuccess: (saved: Saved) => {
+                    window.location.href = saved.redirecturl ?? listUrl;
+                },
+            },
+        }
+        : {
+            mode: 'update' as const,
+            load: async () => ({values: await sendFormEndpointRequest(`${CLIENTS_URL}/${clientId}`).get() as ClientPayload}),
+            update: {
+                action: (payload: ClientPayload) => (
+                    sendFormEndpointRequest(`${CLIENTS_URL}/${clientId}`, 'PATCH').save(payload) as Promise<Saved>
+                ),
+                onSuccess: goToList,
+            },
+        };
+
+    return (
+        <MoodleForm<ClientPayload, ClientPayload, Saved>
+            {...modeProps}
+            defaultValues={isCreate ? {
+                name: '',
+                description: '',
+                clienttype: 'confidential',
+                flows: ['auth_code'],
+                redirecturis: [''],
+                ispkcerequired: true,
+                scopes: [],
+            } : undefined}
+            cancel={{action: goToList}}
+        >
+            <TextField
+                name="name"
+                label={use(getString('name'))}
+                rules={[
+                    required(use(getString('required'))),
+                    maxLength(NAME_MAX_LENGTH, use(getString('maximumchars', 'core', NAME_MAX_LENGTH))),
+                ]}
+            />
+            <TextareaField name="description" label={use(getString('description'))} />
+            {isCreate && (
+                <>
+                <GroupField name="clienttype" label={use(getString('oauth2server_clienttype', 'admin'))} layout="column">
+                    <RadioField
+                        name="clienttype"
+                        value="confidential"
+                        label={use(getString('oauth2server_clienttypeconfidential', 'admin'))}
+                        supportingText={use(getString('oauth2server_clienttypeconfidentialdesc', 'admin'))}
+                    />
+                    <RadioField
+                        name="clienttype"
+                        value="public"
+                        label={use(getString('oauth2server_clienttypepublic', 'admin'))}
+                        supportingText={use(getString('oauth2server_clienttypepublicdesc', 'admin'))}
+                    />
+                </GroupField>
+                <GroupField
+                    name="flows"
+                    label={use(getString('oauth2server_clientprimaryflows', 'admin'))}
+                    layout="column"
+                    disableIf={isPublic}
+                    rules={[minItems(1, flowRequired)]}
+                >
+                    <CheckboxField
+                        name="flows"
+                        value="auth_code"
+                        label={use(getString('oauth2server_clientgranttypeauthcode', 'admin'))}
+                        supportingText={use(getString('oauth2server_clientgranttypeauthcodedesc', 'admin'))}
+                    />
+                    <CheckboxField
+                        name="flows"
+                        value="client_credentials"
+                        label={use(getString('oauth2server_clientgranttypeclientcreds', 'admin'))}
+                        supportingText={use(getString('oauth2server_clientgranttypeclientcredsdesc', 'admin'))}
+                    />
+                </GroupField>
+                <StaticField hideIf={(v) => isPublic(v) || !v.flows.includes('client_credentials')}>
+                    <Alert type="warning" message={use(getString('oauth2server_clientgranttypeclientcredswarning', 'admin'))} />
+                </StaticField>
+                </>
+            )}
+            <RepeaterField
+                name="redirecturis"
+                rules={[minItems(1, redirectUriRequired)]}
+                label={redirectUris}
+                addLabel={use(getString('oauth2server_clientaddcallbackuri', 'admin'))}
+                removeLabel={use(getString('remove'))}
+                hideIf={(v) => (isCreate ? !isPublic(v) && !v.flows.includes('auth_code') : !hasAuthCode)}
+            >
+                <TextField label={redirectUris} hideLabel rules={[url(redirectUriInvalid)]} />
+            </RepeaterField>
+            <CheckboxField
+                name="ispkcerequired"
+                label={use(getString('oauth2server_clientpkcerequired', 'admin'))}
+                supportingText={pkceHelp}
+                hideIf={(v) => (isCreate ? isPublic(v) || !v.flows.includes('auth_code') : !(hasAuthCode && isConfidential))}
+            />
+            <GroupField
+                name="scopes"
+                label={use(getString('oauth2server_scopes', 'admin'))}
+                layout="column"
+                rules={[minItems(1, scopesRequired)]}
+            >
+                {scopes.map((scope) => (
+                    <CheckboxField
+                        key={scope.value}
+                        name="scopes"
+                        value={scope.value}
+                        label={scope.label}
+                        supportingText={scope.description}
+                    />
+                ))}
+            </GroupField>
+            {isCreate && (
+                <StaticField>
+                    <Alert type="warning" message={use(getString('oauth2server_clientcreationwarning', 'admin'))} />
+                </StaticField>
+            )}
+        </MoodleForm>
+    );
+}
+
+// The strings load asynchronously, so the form renders under a Suspense boundary.
+export default function ClientFormLoader(props: Props) {
+    return (
+        <Suspense fallback={null}>
+            <ClientForm {...props} />
+        </Suspense>
+    );
+}
