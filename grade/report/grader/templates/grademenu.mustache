{{!
    @template block_timeline/nav-day-filter

    This template renders the day range selector for the timeline view.

    Example context (json):
    {}
}}
{{#hasmenu}}
    <div class="action-menu dropdown mb-1">
        <button class="btn btn-link btn-icon icon-size-3 grademenubtn"
            type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-id = {{dataid}}>
                <i class="icon fa fa-ellipsis-h fa-fw m-0" title="{{#str}} cellactions, gradereport_grader {{/str}}" aria-hidden="true"></i>
                <span class="sr-only">{{#str}} cellactions, gradereport_grader {{/str}}</span>
        </button>

        <div role="menu" class="dropdown-menu grader" data-skip-active-class="true">
            {{#editurl}}
                {{{editurl}}}
            {{/editurl}}
            {{#editcalculationurl}}
                {{{editcalculationurl}}}
            {{/editcalculationurl}}
            {{#singleviewreporturl}}
                {{{singleviewreporturl}}}
            {{/singleviewreporturl}}
            {{#advancedgradingurl}}
                {{{advancedgradingurl}}}
            {{/advancedgradingurl}}
            <div class="dropdown-divider" role="separator"></div>
            {{#ascendingfirstnameurl}}
                <h6 class="dropdown-header">{{#str}} firstname, moodle {{/str}}</h6>
                {{{ascendingfirstnameurl}}}
                {{{descendingfirstnameurl}}}
                <h6 class="dropdown-header">{{#str}} lastname, moodle {{/str}}</h6>
                {{{ascendinglastnameurl}}}
                {{{descendinglastnameurl}}}
            {{/ascendingfirstnameurl}}
            {{#ascendingurl}}
                {{{ascendingurl}}}
                {{{descendingurl}}}
            {{/ascendingurl}}
            {{#gradesonlyurl}}
                {{{gradesonlyurl}}}
                {{{aggregatesonlyurl}}}
                {{{fullmodeurl}}}
            {{/gradesonlyurl}}
            {{#gradeanalysisurl}}
                {{{gradeanalysisurl}}}
            {{/gradeanalysisurl}}
            {{^isgrade}}
                <div class="dropdown-divider" role="separator"></div>
            {{/isgrade}}
            {{#hideurl}}
                {{{hideurl}}}
            {{/hideurl}}
            {{#lockurl}}
                {{{lockurl}}}
            {{/lockurl}}
        </div>
    </div>
{{/hasmenu}}
