{{!
    @template core_grades/export_action_bar

    Actions bar for the gradebook export pages.

    Context variables required for this template:
    * generalnavselector - The data object containing the required properties to render the general navigation selector.
    * exportselector - The data object containing the required properties to render the export options selector.

    Example context (json):
    {
        "generalnavselector": {
            "title": "Tertiary navigation",
            "activeitemtext": "Action item 1",
            "items": [
                {
                    "name": "Action item 1",
                    "action": "/example1.php",
                    "active": true,
                    "attributes": [
                        {
                            "name": "target",
                            "value": "_blank"
                        }
                    ],
                    "isgroup": false
                },
                {
                    "name": "Group",
                    "actionitems": [
                        {
                            "name": "Action item 2",
                            "action": "/example2.php",
                            "active": false,
                            "attributes": []
                        }
                    ],
                    "isgroup": true
                }
            ]
        },
        "exportselector": {
            "id": "url_select56789",
            "action": "https://example.com/get",
            "formid": "gradesexportactionselect",
            "sesskey": "sesskey",
            "classes": "urlselect",
            "label": "",
            "helpicon": false,
            "showbutton": null,
            "options": [
                {
                    "name": "OpenDocument spreadsheet",
                    "value": "/grade/export/ods/index.php",
                    "selected": true
                }
            ],
            "disabled": false,
            "title": null
        }
    }
}}
<div class="container-fluid tertiary-navigation">
    <div class="row">
        {{#generalnavselector}}
            <div class="navitem">
                {{>core/tertiary_navigation_selector}}
            </div>
        {{/generalnavselector}}
        {{#exportselector}}
            <div class="navitem">
                {{>core/url_select}}
            </div>
        {{/exportselector}}
    </div>
</div>
