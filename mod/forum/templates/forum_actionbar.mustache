{{!
    @template mod_forum/forum_action_bar

    Simple search input.

    Example context (json):
    {
        "action": "https://moodle.local/mod/forum/search.php",
        "inputname": "search",
        "searchstring": "Search settings",
        "query": "themedesigner",
        "hiddenfields": [{
            "name": "id",
            "value": "11"
         }],
         "helpicon": {
         "heading": "Search",
         "text": "<div class='no-overflow'><p>For basic searching .</p></div>",
         "alt": "Help with search",
         "icon": [{
            "attributes": [{
                "name": "alt",
                "value": "Help with Search"
                }, {
                "name": "src",
                "value": "http://localhost/theme/image.php?theme=boost&component=core&image=help"
             }]
          }]
         },
        "newdiscussion": "<a class='btn btn-primary'>Add discussion topic</a>",
        "subscribetoforum": "http://localhost/moodle/mod/forum/subscribe.php?id=7&sesskey=abcd&returnurl=http//localhost/moodle/mod/forum/view.php?id=4",
        "unsubscribefromforum": "http://localhost/moodle/mod/forum/subscribe.php?id=7&sesskey=abcd&returnurl=http//localhost/moodle/mod/forum/view.php?id=4",
        "uniqid": 123456
    }
}}

{{#subscribetoforum}}
    <a class="btn btn-secondary float-right" href="{{ subscribetoforum }}">{{#str}}subscribe, mod_forum {{/str}}</a>
{{/subscribetoforum}}
{{#unsubscribefromforum}}
    <a class="btn btn-secondary float-right" href="{{ unsubscribefromforum }}">{{#str}}unsubscribe, mod_forum {{/str}}</a>
{{/unsubscribefromforum}}
<div class="simplesearchform row mb-3">
    <form autocomplete="off" action="{{ action }}" method="get" accept-charset="utf-8" class="mform form-inline simplesearchform">
        <div class="input-group mr-5">
            {{#helpicon}}
                {{>core/help_icon}}
            {{/helpicon}}
            {{< core/search_input }}
            {{/ core/search_input }}
        </div>
        {{{newdiscussionbtn}}}
    </form>
</div>
