{{!
    @template core_grades/bulkactions/bulk_action_trigger

    Renders a trigger element for a given bulk action.

    Context variables required for this template:
    * action - The name of the action to be performed.
    * title - The title of the action.
    * icon - The HTML for the icon to be displayed.

    Example context (json):
    {
        "action": "move",
        "title": "Move",
        "icon": "<i class='icon fa fa-arrows'></i>"
    }
}}
<button
    type="button"
    class="btn py-0 d-flex flex-column"
    data-action="{{action}}"
    title="{{title}}"
>
    <span class="w-100 pl-2">{{{icon}}}</span>
    <span>{{title}}</span>
</button>
