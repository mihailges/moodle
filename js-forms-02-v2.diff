+import {Checkbox} from '@moodlehq/design-system';
+import {useDefinedField} from '../useDefinedField';
+import type {FieldProps} from './types';
+
+// A single checkbox holding a boolean.
+export function CheckboxField({name, label, supportingText, rules, hideIf, disableIf, id}: FieldProps & {supportingText?: string}) {
+    const f = useDefinedField(name, {rules, hideIf, disableIf});
+    if (f.hidden) {
+        return null;
+    }
+    return (
+        <Checkbox
+            id={id ?? `field_${name.replace(/\W+/g, '_')}`}
+            label={label}
+            supportingText={supportingText}
+            invalid={f.invalid}
+            invalidFeedback={f.message}
+            {...f.registration}
+        />
+    );
+}
diff --git a/public/lib/js/esm/src/forms/fields/CheckboxGroupField.tsx b/public/lib/js/esm/src/forms/fields/CheckboxGroupField.tsx
