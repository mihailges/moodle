    @template core_admin/oauth2/server/generated_client_secret
    @summary Renders the custom heading on the OAuth2 client page.

    Context variables required for this template:
    * clientidentifier - The public client identifier.
    * secret - The generated client secret.

    Example context (json):
    {
        "name": "Community mobile app",
        "clientidentifier": "4c7a2e9f1d6b0835",
        "isactive": true,
        "isconfidential": true,
        "isauthcodesupported": true,
        "isclientcredentialssupported": true,
        "backurl": "/admin/oauth2/clients.php",
    }
}}
<div class="oauth2-secret-display">
    <div class="alert alert-warning d-flex align-items-start mb-3" role="alert">
        <i class="fa fa-exclamation-triangle me-2 mt-1" aria-hidden="true"></i>
        <div>
            {{#str}} oauth2server_clientsecretshownoncewarning, admin {{/str}}
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label fw-bold mb-1">
            {{#str}} oauth2server_clientidentifier, admin {{/str}}
        </label>
        <div class="font-monospace text-dark text-break fw-normal">
            {{clientidentifier}}
        </div>
    </div>
    <div class="mb-3">
        <label for="generated-secret-input" class="form-label fw-bold mb-1">
            {{#str}} oauth2server_clientsecretvalue, admin {{/str}}
        </label>
        <input type="text"
               id="generated-secret-input"
               class="form-control font-monospace text-dark bg-white"
               value="{{secret}}"
               readonly
               aria-label="{{#str}} oauth2server_clientsecretvalue, admin {{/str}}">
    </div>
    <div>
        <button type="button"
                class="btn btn-secondary d-inline-flex align-items-center"
                id="copy-secret-btn"
                data-action="copytoclipboard"
                data-clipboard-target="#generated-secret-input"
                data-clipboard-success-message="{{#str}} oauth2server_clientsecretcopied, admin {{/str}}">
            <i class="fa fa-clipboard me-2" aria-hidden="true"></i>
            <span>{{#str}} copytoclipboard, core {{/str}}</span>
        </button>
    </div>
</div>
{{#js}}
    require(['core/copy_to_clipboard']);
{{/js}}