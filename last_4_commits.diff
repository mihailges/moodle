@@ -0,0 +1,93 @@
+<?php
+// This file is part of Moodle - http://moodle.org/
+//
+// Moodle is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// Moodle is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\hook\form;
+
+/**
+ * Allows plugins to extend a React form that supports extensions.
+ *
+ * A plugin adds a JavaScript module that registers its form components in the form's slots
+ * (see registerFormExtension in @moodle/lms/core/forms), and can supply the initial values of its fields.
+ * The fields must be named "extensions.<component>.<field>" so that the values are submitted with the form,
+ * and are handed to the {@see before_form_validation} and {@see after_form_saved} hooks.
+ * Listeners should ignore forms they do not know by checking the form name.
+ *
+ * @package    core
+ * @copyright  2026 Mihail Geshoski <mihailgesoski@gmail.com>
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[\core\attribute\label('Allows plugins to extend a React form with their own fields')]
+#[\core\attribute\tags('forms')]
+final class extend_form {
+    /** @var string[] The ES modules to load with the form, by specifier. */
+    private array $modules = [];
+
+    /** @var array The initial values of the extension fields, by component. */
+    private array $values = [];
+
+    /**
+     * Constructor.
+     *
+     * @param string $formname The name of the form, in the form "<component>_<form>".
+     */
+    public function __construct(
+        /** @var string The name of the form. */
+        public readonly string $formname,
+    ) {
+    }
+
+    /**
+     * Load an ES module with the form. It should register its form extensions when imported.
+     *
+     * @param string $specifier The module specifier, in the form "@moodle/lms/<component>/<path>".
+     */
+    public function add_module(string $specifier): void {
+        if (!preg_match('~^@moodle/lms/[a-z][a-z0-9_]*(/[A-Za-z0-9_.-]+)+$~', $specifier) || str_contains($specifier, '..')) {
+            throw new \coding_exception("Invalid form extension module '{$specifier}'");
+        }
+        if (!in_array($specifier, $this->modules, true)) {
+            $this->modules[] = $specifier;
+        }
+    }
+
+    /**
+     * Set the initial values of a plugin's extension fields, available as "extensions.<component>.<field>".
+     *
+     * @param string $component The plugin's frankenstyle component name.
+     * @param array $values The field values, which must be JSON serialisable.
+     */
+    public function set_values(string $component, array $values): void {
+        $this->values[$component] = $values;
+    }
+
+    /**
+     * The modules to load.
+     *
+     * @return string[]
+     */
+    public function get_modules(): array {
+        return $this->modules;
+    }
+
+    /**
+     * The initial extension values, by component.
+     *
+     * @return array
+     */
+    public function get_values(): array {
+        return $this->values;
+    }
+}
diff --git a/public/lib/classes/route/api/test_form.php b/public/lib/classes/route/api/test_form.php
new file mode 100644
index 00000000000..ca8cba55130
--- /dev/null
+++ b/public/lib/classes/route/api/test_form.php
@@ -0,0 +1,172 @@
+<?php
+// This file is part of Moodle - http://moodle.org/
+//
+// Moodle is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// Moodle is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Moodle.  If not, see <http://www.gnu.org/licenses/>.
+
+namespace core\route\api;
+
+use core\hook\form\after_form_saved;
+use core\hook\form\before_form_validation;
+use core\param;
+use core\router\require_login;
+use core\router\route;
+use core\router\schema\objects\array_of_strings;
+use core\router\schema\objects\array_of_things;
+use core\router\schema\objects\scalar_type;
+use core\router\schema\objects\schema_object;
+use core\router\schema\request_body;
+use core\router\schema\response\content\payload_response_type;
+use core\router\schema\response\payload_response;
+use core\router\schema\response\response;
+use GuzzleHttp\Psr7\Response as HttpResponse;
+use Psr\Http\Message\ResponseInterface;
+use Psr\Http\Message\ServerRequestInterface;
+
+/**
+ * Dummy endpoint of the React forms test page (/test.php). Nothing is stored by core: it validates the data,
+ * lets plugins validate and act on their extension data through the form hooks, and echoes the data back.
+ *
+ * @package    core
+ * @copyright  2026 Mihail Geshoski <mihailgesoski@gmail.com>
+ * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+class test_form {
+    /** @var string The name of the form, as passed to the form hooks. */
+    public const string FORM_NAME = 'core_test_form';
+
+    /**
+     * Save the test form.
+     *
+     * @param ServerRequestInterface $request The request object
+     * @param ResponseInterface $response The response object
+     * @return payload_response The saved data, or the validation errors
+     */
+    #[route(
+        path: '/test/form',
+        method: ['POST'],
+        title: 'Save the React forms test form',
+        description: 'A dummy endpoint for the React forms test page. It stores nothing but lets plugins extend the form.',
+        requestbody: new request_body(
+            required: true,
+            content: new payload_response_type(
+                schema: new schema_object(
+                    content: [
+                        'title' => new scalar_type(param::RAW, required: true),
+                        'description' => new scalar_type(param::RAW),
+                        'priority' => new scalar_type(param::ALPHA),
+                        'notify' => new scalar_type(param::BOOL),
+                        'notifyEmail' => new scalar_type(param::RAW),
+                        'tags' => new array_of_strings(keyparamtype: param::INT, valueparamtype: param::ALPHANUMEXT),
+                        'emails' => new array_of_strings(keyparamtype: param::INT, valueparamtype: param::RAW),
+                        'rating' => new scalar_type(param::INT),
+                        'color' => new scalar_type(param::RAW),
+                        'internalNote' => new scalar_type(param::RAW),
+                        'externalId' => new scalar_type(param::RAW),
+                        'slug' => new scalar_type(param::RAW),
+                        'website' => new scalar_type(param::RAW),
+                        // Data of plugin form extensions, by component. Validated by the plugins' hook callbacks.
+                        'extensions' => new array_of_things(),
+                    ],
+                ),
+            ),
+        ),
+        responses: [
+            new response(statuscode: 201, description: 'The form was saved'),
+            new response(statuscode: 422, description: 'The submitted data is not valid'),
+        ],
+        requirelogin: new require_login(
+            requirelogin: true,
+            autologinguest: false,
+        ),
+    )]
+    #[\core\router\scope\scopeset(
+        new \core_admin\route\scope\config\read(),
+        new \core_admin\route\scope\config\write(),
+    )]
+    public function save(
+        ServerRequestInterface $request,
+        ResponseInterface $response,
+    ): payload_response {
+        require_capability('moodle/site:config', \core\context\system::instance());
+
+        $data = $request->getParsedBody() ?? [];
+        $errors = $this->validate($data);
+
+        $hook = new before_form_validation(self::FORM_NAME, $data);
+        \core\di::get(\core\hook\manager::class)->dispatch($hook);
+        $errors = array_merge_recursive($errors, $hook->get_errors());
+
+        if ($errors) {
+            return new payload_response(
+                payload: ['message' => 'The submitted data is not valid', 'errors' => $errors],
+                request: $request,
+                response: new HttpResponse(422),
+            );
+        }
+
+        // Nothing is stored here, so the id is made up. Plugins save their own data in this hook.
+        $id = time();
+        \core\di::get(\core\hook\manager::class)->dispatch(new after_form_saved(self::FORM_NAME, $id, $data));
+
+        return new payload_response(
+            payload: ['id' => $id] + $data,
+            request: $request,
+            response: new HttpResponse(201),
+        );
+    }
+
+    /**
+     * Validate the fields of the form itself.
+     *
+     * @param array $data The submitted data.
+     * @return array<string, string[]> The errors, keyed by field path.
+     */
+    protected function validate(array $data): array {
+        $errors = [];
+
+        $title = trim((string) ($data['title'] ?? ''));
+        if ($title === '') {
+            $errors['title'][] = 'The title is required';
+        } else if (\core_text::strlen($title) > 50) {
+            $errors['title'][] = 'The title must be at most 50 characters long';
+        }
+
+        if (!empty($data['notify']) && !validate_email((string) ($data['notifyEmail'] ?? ''))) {
+            $errors['notifyEmail'][] = 'Enter a valid email to notify';
+        }
+
+        $rating = (int) ($data['rating'] ?? 0);
+        if ($rating < 1 || $rating > 5) {
+            $errors['rating'][] = 'The rating must be between 1 and 5';
+        }
+
+        if (!preg_match('/^#[0-9a-f]{6}$/i', (string) ($data['color'] ?? ''))) {
+            $errors['color'][] = 'The colour must be a hex value like #3366ff';
+        }
+
+        foreach (['externalId', 'slug'] as $field) {
+            if (!preg_match('/^[a-z0-9-]+$/', (string) ($data[$field] ?? ''))) {
+                $errors[$field][] = 'Use lowercase letters, numbers and dashes';
+            }
+        }
+
+        foreach (array_values($data['emails'] ?? []) as $i => $email) {
+            if ($email !== '' && !validate_email((string) $email)) {
+                $errors["emails.{$i}"][] = 'This is not a valid email address';
+            }
+        }
+
+        return $errors;
+    }
+}
