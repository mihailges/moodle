{{!
   @template admin/oauth2/server/client_management_actionbar

   Actions bar for the OAuth 2 clients management page.

   Classes required for JS:
   * none

   Context variables required for this template:
   * createclientlink - The link to create a new client.

   Example context (json):
   {
       "createclientlink": "https://moodle.org"
   }

}}
<div class="container-fluid tertiary-navigation">
   <div class="d-flex">
       <div class="navitem">
           <h2>{{#str}} oauth2server_clients, admin {{/str}}</h2>
       </div>
       <div class="navitem ms-sm-auto align-self-center">
           <a class="btn btn-primary" href="{{createclientlink}}">
               <i class="fa fa-plus me-1" aria-hidden="true"></i>
               {{#str}} oauth2server_clientcreate, admin {{/str}}
           </a>
       </div>
   </div>
</div>
